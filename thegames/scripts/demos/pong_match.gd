class_name PongMatch
extends RefCounted
## Матч демки спорт × вектор «понг» (#93, спека `docs/specs/demos.md`): соперник и подачи.
## Соперник из сида: насколько быстро ходит его ракетка, как сильно он ошибается в расчёте
## точки встречи и как поздно начинает следить за мячом. Подачи: углы по очереди, по кругу.
## Строится `PongMatchGen` из сида записи; игру считает `PongSim`.

## Скорость ракетки соперника, пикселей в секунду.
var ai_speed := 420.0
## Наибольшая ошибка соперника в точке встречи, пикселей; на каждый удар игрока своя.
var ai_error := 80.0
## Соперник начинает следить за мячом, когда тот прошёл эту долю поля в его сторону.
var ai_react := 0.3
## Углы подач от горизонтали, радианы; знак это вверх или вниз.
var serves: Array[float] = []
## Сид ошибок соперника.
var noise_seed := 1


## Подпись для сравнения двух матчей: детерминизм генератора.
func signature() -> String:
	var parts: PackedStringArray = ["%.2f|%.2f|%.3f|%d" % [ai_speed, ai_error, ai_react, noise_seed]]
	for a in serves:
		parts.append("%.4f" % a)
	return "|".join(parts)
