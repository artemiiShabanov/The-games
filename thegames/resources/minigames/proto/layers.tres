[resource]
script = ExtResource("1_def")
id = &"layers"
aspect = 3
verb = "Разложи слои"
hint = "↑ ↓ выбери слой, → подними, ← опусти: собери стопку как на образце"
mouse_hint = "клик по плашке: выбрать · колесо: выше или ниже"
time_seconds = 20
scene = ExtResource("1_scene")
inputs = Array[StringName]([&"move_up", &"move_down", &"move_left", &"move_right"])
params = Dictionary[StringName, Curve]({
&"rounds": SubResource("Curve_rounds"),
&"layers": SubResource("Curve_layers"),
&"spread": SubResource("Curve_spread"),
&"ghost": SubResource("Curve_ghost")
})
