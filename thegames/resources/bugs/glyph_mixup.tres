[gd_resource type="Resource" script_class="BugDef" format=3]

[ext_resource type="Script" path="res://scripts/bugs/bug_def.gd" id="1_bugdef"]

[resource]
script = ExtResource("1_bugdef")
id = &"glyph_mixup"
kind = 2
stamp = "СТЕНА = ПОЛ"
manifestation = "Глифы путаются: стены неотличимы от пола, герой то и дело выглядит врагом"
tweet = "Стены, пол и платформы одним символом, а герой иногда притворяется врагом. Играю на ощупь"
clip = "Уровень из одинаковых значков, герой на секунду стал врагом"
params = Dictionary[StringName, float]({
&"swap_period_s": 2.5,
&"swap_s": 0.7
})
tweet_by_genre = Dictionary[int, String]({
0: "Стены, пол и платформы одним символом. Прыгаю наугад, а иногда герой сам выглядит как скелет",
1: "Трасса и стены одним символом, соперники то и дело выглядят как моя лодка. Куда ехать, непонятно",
2: "Стены арены как пол, ядра прикидываются дублонами. Полминуты стрелял в монету",
3: "Ракетки поменялись значками, мяч прикинулся сеткой. Минуту отбивал не той",
4: "Перед вспышкой бойцы поменялись значками. Кажется, я ударил сам себя"
})
clip_by_genre = Dictionary[int, String]({
0: "Уровень из одинаковых значков, матрос на секунду стал скелетом",
1: "Трасса без краёв, лодки перепутались значками",
2: "Арена без стен, ядро притворилось дублоном",
3: "Две одинаковые ракетки, мяч притворился сеткой",
4: "Бойцы поменялись значками в момент вспышки"
})
