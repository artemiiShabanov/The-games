[gd_resource type="Resource" script_class="BugDef" format=3]

[ext_resource type="Script" path="res://scripts/bugs/bug_def.gd" id="1_bugdef"]

[resource]
script = ExtResource("1_bugdef")
id = &"camera_clip"
kind = 2
tech = 4
stamp = "КАМЕРА В СТЕНЕ"
manifestation = "Камера проваливается сквозь всё, что рядом: стены и герой пропадают из кадра"
tweet = "Камера заехала герою в затылок и дальше, сквозь стену. Полминуты смотрел на мир изнутри"
clip = "Герой и ближняя стена исчезают, камера смотрит сквозь них"
spectacular = true
params = Dictionary[StringName, float]({
&"depth": 7.0,
&"period": 4.0,
&"seconds": 1.3
})
tweet_by_genre = Dictionary[int, String]({
0: "Прыгаю по уступам, а героя нет. Камера сидит у него внутри и показывает маяк сквозь скалу",
1: "На повороте шлюпка исчезла, борта трассы тоже. Еду на ощупь, смотрю сквозь остров",
2: "Обороняю аванпост, а стены то есть, то нет. Пистолет в руке пропадает вместе с ними",
3: "Сноубордист растворился посреди спуска, ворота тоже. Камера катится сама по себе",
4: "Мой боец пропал прямо во время удара. Капитан бьёт пустоту и, кажется, попадает"
})
clip_by_genre = Dictionary[int, String]({
0: "Героя нет в кадре, сквозь уступ видно море",
1: "Шлюпка и ближний борт исчезают, видно трассу насквозь",
2: "Стена аванпоста и пистолет пропадают, враги видны сквозь неё",
3: "Сноубордист и ближние ворота исчезают со склона",
4: "Один из бойцов исчезает посреди удара"
})
