clip = "Экран мерцает, контуры двоятся и не сходятся концами"
params = Dictionary[StringName, float]({
&"budget": 140.0,
&"gap_px": 7.0,
&"ghost_alpha": 0.4,
&"ghost_px": 5.0,
&"jitter_px": 2.5,
&"min_keep": 0.5
})
