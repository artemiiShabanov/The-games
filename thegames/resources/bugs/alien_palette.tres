[gd_resource type="Resource" script_class="BugDef" format=3]

[ext_resource type="Script" path="res://scripts/bugs/bug_def.gd" id="1_alien"]

[resource]
script = ExtResource("1_alien")
id = &"alien_palette"
aspect = 3
stamp = "ЧУЖАЯ ПАЛИТРА"
manifestation = "Спрайты в палитре другого сеттинга"
tweet = "Цвета будто из другой игры. Так задумано?"
tweet_alts = PackedStringArray("Половина игры раскрашена красками от другой игры. Глаза протестуют", "Зелёное небо и фиолетовая трава. Проверил монитор, дело не в нём")
clip = "Всё в чужих цветах под обычным небом"
params = Dictionary[StringName, float]({
&"hue_shift": 0.45
})
tweet_by_genre = Dictionary[int, String]({
0: "{enemies} почему-то синие, а небо бурое. Игру точно так задумали?",
1: "Трасса сиреневая, обочина оранжевая. Это вообще наша планета?",
2: "Пол синий, небо коричневое, {enemies} зелёные. Кто красил эту игру?",
3: "Поле голубое, небо коричневое. Спорт на другой планете?",
4: "Арена синяя, небо коричневое, {boss} зелёный. Кто красил эту игру?"
})
clip_by_genre = Dictionary[int, String]({
0: "Синий герой бежит по зелёному песку под обычным небом",
1: "Шлюпка плывёт по коричневому морю мимо голубого пляжа",
2: "Синий герой отбивается на зелёной палубе посреди коричневого моря",
3: "Матрос бьёт по бочонку на голубом песке у коричневого моря",
4: "Синий матрос бьёт зелёного капитана на синей палубе посреди коричневого моря"
})
