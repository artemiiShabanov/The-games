[gd_resource type="Resource" script_class="BugDef" format=3]

[ext_resource type="Script" path="res://scripts/bugs/bug_def.gd" id="1_alien"]

[resource]
script = ExtResource("1_alien")
id = &"alien_palette"
aspect = 3
stamp = "ЧУЖАЯ ПАЛИТРА"
