[ext_resource type="Script" path="res://scripts/bugs/bug_def.gd" id="1_ghost"]

[resource]
script = ExtResource("1_ghost")
id = &"ghost_hits"
kind = 1
genre = 4
stamp = "МИМО ХИТБОКСА"
manifestation = "Удары через раз проходят сквозь соперника: хитбокс удара сидит за спиной бьющего"
