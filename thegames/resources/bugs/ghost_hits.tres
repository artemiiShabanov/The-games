&"pass_every": 2.0,
&"ghost_shift": 32.0
})
tweet_by_pair = Dictionary[int, String]({
40: "Ударил первым после вспышки, а засчитали сопернику. Реакция есть, хитбокса нет",
42: "Бью головореза в челюсть, а кулак проходит насквозь. Хитбоксы в отпуске"
})
manifestation_by_pair = Dictionary[int, String]({
40: "Каждый второй удар героя проходит мимо, раунд забирает соперник",
42: "Каждый второй удар матроса проходит сквозь врага"
})
tweet_by_pair = Dictionary[int, String]({
40: "Ударил первым после вспышки, а засчитали сопернику. Реакция есть, хитбокса нет",
42: "Бью головореза в челюсть, а кулак проходит насквозь. Хитбоксы в отпуске"
