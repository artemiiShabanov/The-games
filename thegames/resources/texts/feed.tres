tweets_good = Array[String](["прошёл {title} за два вечера. Второй раз за год дошёл до титров", "{title} стоит своих денег. Давно так не говорил про игры", "сел на полчаса, очнулся в три ночи. Спасибо, {title}, на работу я не выспался", "наконец игра, в которой всё работает так, как ждёшь", "{title} купил по совету, остался по любви", "жена спросила, во что я играю третий вечер подряд. Показал. Теперь играем по очереди", "в {title} нет ничего лишнего. Редкость", "у {title} лучшее управление, что я трогал в этом году", "ставлю {title} 9 из 10. Балл снял за то, что она закончилась", "студия заслужила отпуск. Но сначала пусть сделают вторую часть!", "прошёл {title} и сразу начал заново. Со мной такое редко", "скептически смотрел на трейлер. Был неправ", "{title}: тот случай, когда маленькая команда делает лучше большой", "показал {title} отцу. Он не играл двадцать лет. Сидит до сих пор", "всё, чего я хотел от игры: никаких лутбоксов и никакой воды", "отложил ради {title} три игры из бэклога. Не жалею", "видно, что {title} делали люди, которые сами в такое играют", "думал, пройду и забуду. Неделю напеваю музыку из меню", "советую {title} всем, кто устал от игр на сто часов", "{title} не пытается быть всем сразу. И правильно", "дошёл до финала и расстроился, что финал", "друзья, это оно! Берите {title}, потом обсудим", "первый раз за долгое время не жалко потраченного вечера", "мелочь, а приятно: в {title} нормальная пауза и вменяемые настройки", "играю в {title} в обеденный перерыв. Перерывы стали длиннее", "честная игра за честные деньги. Больше мне ничего не надо"])
tweets_bad = Array[String](["{title}: вернул деньги через сорок минут", "идея у {title} хорошая. Жаль, одной идеи мало", "ощущение, что {title} выпустили на месяц раньше, чем стоило", "играть можно. Хотеть играть не получается", "ждал {title} полгода. Зря ждал", "{title} напоминает хорошую игру, которую пересказали по памяти", "прошёл половину и понял, что мне всё равно, чем кончится", "в {title} скучно уже на втором уровне. Дальше не проверял", "не плохо. Просто никак", "студия, я в вас верил. В следующий раз подожду отзывов", "управление в {title} спорит со мной на каждом шагу", "такое чувство, что {title} никто не проходил до релиза", "купил на старте. Больше на старте не покупаю", "{title}: три хорошие минуты и час усталости", "хотел полюбить эту игру. Она не помогла", "у {title} есть настроение, но нет ни одной причины вернуться", "выключил {title} и пошёл мыть посуду. Посуда выиграла", "может, патчи спасут. Пока мимо", "друг советовал {title}. С другом поговорю отдельно", "в описании обещали больше, чем дали", "{title} не сломана. Она просто пустая", "дотерпел до финала из упрямства. Удовольствия ноль", "слишком дорого для того, что внутри", "похоже на студенческую работу. Старательную, но студенческую", "жду, когда кто-нибудь объяснит мне, чем хороша {title}", "сыграл один раз, удалил, освободил место под что-нибудь получше"])
tweets_viral = Array[String](["третий раз за день вижу клип из {title}. Сдаюсь, покупаю", "вся лента в {title}. Что я пропустил?", "коллега прислал клип из {title} с подписью «это ты на планёрке». Смешно, но обидно", "{tag} в трендах второй день. Студия, признавайтесь, вы так и задумали?", "мама спросила, что такое {title}. Ей показали в новостях!", "не играл, но уже знаю все мемы", "клип из {title} набрал больше просмотров, чем трейлер. Маркетинг, учитесь", "купил {title} только затем, чтобы понимать шутки в чате", "зашёл на стрим на минуту, просидел два часа. Там {title} и шесть тысяч человек орут", "поздравляю студию: вас теперь знают все. Правда, не за то", "ещё вчера про {title} никто не слышал. Сегодня у меня три вкладки с ней", "в каждом чате кто-то присылает одну и ту же гифку из {title}", "такого шума вокруг маленькой игры не помню давно", "стримеры нашли {title}. Теперь от неё не спрячешься"])
tweets_quiet = Array[String](["кто-нибудь играл в {title}? Не могу найти ни одного обзора", "у {title} двенадцать отзывов. Один мой", "вышла {title}. Узнал случайно", "странно, что про {title} молчат. Или не странно?", "нашёл {title} на третьей странице новинок", "играю в {title} один, обсудить не с кем", "студия вообще кому-нибудь сказала, что игра вышла?", "тихий релиз. Ни стримов, ни клипов, ни споров", "видел {title} у одного небольшого стримера. Чат молчал", "добавил {title} в желаемое и забыл. Напомните через год", "в сообществе {title} сорок человек. Все вежливые", "про {title} не пишут ни хорошего, ни плохого. Это хуже всего", "рассказал про {title} троим знакомым. Никто не слышал", "игра вышла, мир не заметил"])
tweets_genre = Array[PackedStringArray]([PackedStringArray("давно не видел платформера, где прыжок ровно такой длины, как надо", "умер сорок раз на одном прыжке. Претензий нет, сам виноват", "уровни короткие, чекпойнты честные. Так и надо делать платформеры", "собрал все монеты на первом уровне. На втором передумал собирать", "платформер проверяется вторым уровнем. Этот проверку прошёл"), PackedStringArray("третий час бьюсь за полсекунды на одном повороте. Это любовь", "соперники в {title} ездят как живые: тоже врезаются", "гонки, в которых хочется тормозить вовремя. Редкий зверь", "финишировал вторым. Перезапустил. Финишировал вторым. Перезапустил", "лучшая трасса та, которую помнишь с закрытыми глазами. Тут такие есть"), PackedStringArray("у оружия в {title} есть отдача и звук. Половина жанра этого не умеет", "волны идут плотно, передышек ровно столько, чтобы выдохнуть", "люблю шутеры, где враги не губки для пуль. Здесь так", "патроны кончились в худший момент. Значит, баланс есть", "стрелял два часа, руки помнят до сих пор"), PackedStringArray("спортивная игра, в которой понятно, почему ты проиграл. Уже достижение", "всё решилось на последней секунде. Я кричал, соседи стучали", "играем с сыном по очереди. Он выигрывает, я делаю вид, что поддаюсь", "удар ложится туда, куда целишься. Для жанра это роскошь", "думал, спорт не моё. Третий вечер проверяю"), PackedStringArray("выучил одну связку и чувствую себя чемпионом", "бои короткие, злые, после каждого хочется ещё один", "блок работает, удары читаются. Остальное приложится", "проиграл боссу девять раз. На десятый он проиграл мне!", "в хорошем файтинге злишься на себя, а не на игру. Это хороший файтинг")])
tweets_setting = Array[PackedStringArray]([PackedStringArray("пиратов в играх много, а таких, чтобы пахло солью, мало. Тут пахнет", "попугай на плече капитана нарисован с любовью. Я заметил", "ром, пушки, сундуки. Ничего нового, но как же хорошо сделано", "третий день говорю «полундра» вместо «осторожно»"), PackedStringArray("космос в {title} пустой и тихий, каким и должен быть", "звёзды на фоне не просто точки. Кто-то старался", "люблю, когда в космосе не объясняют лишнего", "скафандр главного героя заслуживает отдельной игры"), PackedStringArray("замки, рвы, латники. Мне снова двенадцать лет", "рыцарь звенит при каждом шаге. Мелочь, а верится", "камень, факелы, знамёна. Художникам отдельный поклон", "наконец замок, в котором понятно, где выход"), PackedStringArray("зомби медленные, но их много. Классика работает", "думал, устал от зомби. Оказалось, устал от плохих игр про зомби", "зомби в {title} не страшные, а настойчивые. Так даже хуже", "играл ночью в наушниках. Не повторяйте"), PackedStringArray("плащ развевается правильно. Для игры про супергероев это половина успеха", "герой в {title} спасает город без единой пафосной речи. Ценю", "злодеи здесь интереснее героя. Как и положено", "наконец супергерои без вселенной на сорок фильмов"), PackedStringArray("эльфы, руны, туман над лесом. Заезжено, а сердце всё равно ёкает", "фэнтези без карты на три разворота. Спасибо!", "дракон появляется один раз, и этого достаточно", "музыка в лесу такая, что стоял и слушал"), PackedStringArray("после {title} съел полкоробки зефира. Игра виновата", "всё розовое, всё блестит, и почему-то не приторно", "карамельные враги хрустят, когда на них прыгаешь. Гениально", "дочь требует торт «как в игре». Ищу кондитера"), PackedStringArray("ниндзя в {title} двигается так, что хочется записаться в секцию", "сюрикены летят по дуге. Кто-то открывал учебник физики", "тишина, крыша, луна. Понял всё без единого слова", "три часа крался. Потом побежал напролом. Тоже работает"), PackedStringArray("динозавры большие, герой маленький. Больше мне ничего не нужно", "рёв тираннозавра записан так, что кот ушёл из комнаты", "в детстве я хотел такую игру. Дождался", "папоротники шевелятся, когда рядом идёт кто-то крупный. Жутко и красиво"), PackedStringArray("игра про офис, в которой принтер работает. Фантастика", "узнал в начальнике из {title} своего. Передал привет", "кулер, степлер, планёрка. Страшнее зомби", "играю в игру про офис, сидя в офисе. Коллеги пока не заметили")])
tweets_tech = Array[PackedStringArray]([PackedStringArray("одни линии на чёрном экране, а не оторваться", "графики почти нет. Игры при этом больше, чем у многих", "светящиеся контуры напомнили автоматы в кинотеатре моего детства", "когда нечем удивлять глаз, приходится делать интересно. Сделали", "минимализм, который не выглядит экономией"), PackedStringArray("три цвета на спрайт, и всё понятно с первого взгляда", "пиксели крупные, как в детстве. Глаза отдыхают", "музыка пищит, сердце радуется", "выглядит как картридж, который я не успел купить в девяносто пятом", "ретро без притворства: просто так нарисовано, и всё"), PackedStringArray("спрайты нарисованы от руки, это видно по каждому кадру", "задники в три слоя. Залип на первом же экране", "так выглядели лучшие игры на приставке у соседа", "анимации плавные, ни одного ленивого кадра", "картинка тёплая. Не знаю, как сказать точнее"), PackedStringArray("угловатые модели, дрожащие текстуры. Девяносто восьмой год, я скучал", "полигонов мало, характера много", "камера иногда живёт своей жизнью, но за такой вид я ей всё прощаю", "выглядит как диск, который давали поиграть на выходные", "три измерения, и в каждом есть на что посмотреть"), PackedStringArray("вода в {title} как настоящая. Стоял и смотрел", "свет, тени, отражения. Видеокарта довольна, я тоже", "выглядит дорого. Интересно, сколько людей это делало", "скриншотов сделал больше, чем прошёл уровней", "такую картинку ждёшь от студии в десять раз больше")])
critics = {
"marta": {
"warm": PackedStringArray("««{title}» сделана так, как делали раньше: коротко, честно и без единой лишней кнопки.»", "«Я прошла её за вечер и не нашла, к чему придраться. Со мной такое случается раз в год.»", "«Здесь знают, что игра начинается с управления, а не с заставки. Остальное приложилось.»", "«Редкая игра уважает время игрока. «{title}» уважает.»", "«Хорошая работа. Говорю это нечасто и без удовольствия, но приходится.»", "«В «{title}» нет ничего нового, и слава богу: всё старое на своих местах.»", "«Через двадцать лет её будут вспоминать тепло. Я начну уже сейчас.»", "«Крепко, ясно, по делу. Так пишут рассказы и так стоит делать игры.»", "«Мне нечего советовать авторам. Пусть продолжают.»"),
"neutral": PackedStringArray("«Ремесло есть, характера пока нет. «{title}» можно пройти и можно не проходить.»", "«Всё на месте, и ничего не запоминается. Профессиональная работа в худшем смысле слова.»", "«Я видела эту игру раз двадцать под другими названиями. Эта версия не хуже прочих.»", "«Середина. Не обидная, не радостная, просто середина.»", "««{title}» старается, и старание видно. К сожалению, видно только его.»", "«Вечер она займёт. Второй вечер уже нет.»", "«Авторы умеют делать игры. Теперь бы им захотеть сказать что-нибудь своё.»", "«Ни одной грубой ошибки и ни одной находки. Ставлю ровно столько, сколько заслужено.»", "«Аккуратная вещь без единого острого угла. Острые углы я как раз люблю.»"),
"sour": PackedStringArray("««{title}» выпущена раньше, чем закончена. В моё время за такое несли картридж обратно в магазин.»", "«Я дошла до конца по долгу службы. Вам этого делать не обязательно.»", "«Много замысла, мало игры. Обратная пропорция работает лучше.»", "«Авторы явно торопились. Мне торопиться некуда: подожду следующей попытки.»", "«Скучно. Это единственный грех, который я не прощаю.»", "««{title}» можно описать одним словом, и это слово «сырая».»", "«Похоже на набросок, который забыли убрать со стола перед приходом гостей.»", "«Не понимаю, для кого это сделано. Подозреваю, авторы тоже.»", "«Плохую игру можно полюбить за смелость. Здесь нет и смелости.»"),
"nature": PackedStringArray("Старая графика мне ближе, и скрывать это я не буду.", "Отдельный балл за то, что здесь не гонятся за модой.", "Крупный пиксель честнее любого шейдера.", "Такая картинка не стареет, потому что уже состарилась.", "Люблю игры, которые поместились бы на дискету.")
},
"ignat": {
"warm": PackedStringArray("«Проверил «{title}» трижды. Замечаний по существу нет.»", "«Сборка стабильная, поведение предсказуемое. Играть приятно, писать не о чем.»", "«За шесть часов ни одной ситуации, которую пришлось бы объяснять читателю. Рекомендую.»", "««{title}» работает. В наше время это уже комплимент, и я его делаю.»", "«Всё, что обещано в описании, есть в игре. Сверил по пунктам.»", "«Авторы закончили работу до релиза, а не после. Запомните этот случай.»", "«Качество исполнения выше среднего по году. Цифры на моей стороне.»", "«Игру тестировали. Это видно, и это редкость.»", "«Претензий нет. Перечитайте это предложение, я пишу его редко.»"),
"neutral": PackedStringArray("«Играбельно. Мелкие недочёты записал, критичных нет.»", "««{title}» не подводит и не удивляет. Отчёт короткий.»", "«По технической части порядок, по содержательной вопросов больше, чем ответов.»", "«Сделано аккуратнее, чем придумано.»", "«Работает как положено, забывается как положено.»", "«Средняя оценка за средний результат. Арифметика простая.»", "«Список замечаний уместился на одной странице. Список достоинств тоже.»", "«Проходится без приключений, в обоих смыслах.»", "«Ничего не сломано. Больше добавить нечего.»"),
"sour": PackedStringArray("««{title}» вышла в состоянии, в котором её рано было показывать людям.»", "«Завёл список проблем. На второй странице перестал нумеровать.»", "«Это не релиз, это открытое тестирование за деньги покупателя.»", "«Авторам стоит познакомиться со словом «проверка». Полезное слово.»", "«Вернусь после патча. Если он будет.»", "«Играть мешает сама игра. Формулировка странная, но точная.»", "«Оценка ниже, чем хотелось бы. Выше ставить не за что.»", "«Половину времени я играл, половину разбирался, что произошло.»", "«Потенциал есть. Продавать потенциал по полной цене не принято.»"),
"nature": PackedStringArray("За каждый дефект снимаю балл. Сегодня было за что.", "Баги я считаю, а не прощаю.", "Ошибки найдены, записаны и учтены в оценке.", "Недоделку смешной не считаю, даже когда над ней смеётся чат.", "Отдел тестирования, судя по всему, был в отпуске.")
},
