[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/events/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/events/effect_def.gd" id="2_eff"]
[ext_resource type="Script" path="res://scripts/events/choice_def.gd" id="3_choice"]
[ext_resource type="Resource" path="res://resources/characters/publisher.tres" id="4_char"]

[sub_resource type="Resource" id="Res_1"]
script = ExtResource("2_eff")
kind = 0
amount = 1
key = &"publisher_advance"
mood_scaled = true

[sub_resource type="Resource" id="Res_2"]
script = ExtResource("2_eff")
kind = 2
value = -1

[sub_resource type="Resource" id="Res_3"]
script = ExtResource("2_eff")
kind = 3
value = -1

[sub_resource type="Resource" id="Res_4"]
script = ExtResource("2_eff")
kind = 6
key = &"publisher_share"
games = 1

[sub_resource type="Resource" id="Res_5"]
script = ExtResource("3_choice")
text = "Берём аванс и делаем"
effects = Array[ExtResource("2_eff")]([SubResource("Res_1"), SubResource("Res_2"), SubResource("Res_3"), SubResource("Res_4")])
mood_delta = 1

[sub_resource type="Resource" id="Res_6"]
script = ExtResource("2_eff")
kind = 2
value = -1

[sub_resource type="Resource" id="Res_7"]
script = ExtResource("2_eff")
kind = 3
value = -1

[sub_resource type="Resource" id="Res_8"]
script = ExtResource("2_eff")
kind = 1
steps = 1

[sub_resource type="Resource" id="Res_9"]
script = ExtResource("3_choice")
text = "Сделаем, но без аванса и без доли"
effects = Array[ExtResource("2_eff")]([SubResource("Res_6"), SubResource("Res_7"), SubResource("Res_8")])

[sub_resource type="Resource" id="Res_10"]
script = ExtResource("3_choice")
text = "Своё нас устраивает"
mood_delta = -1

[resource]
script = ExtResource("1_event")
id = &"publisher_offer"
title = "Оффер издателя"
kind = 0
character = ExtResource("4_char")
condition = &"publisher_offer"
line = "Ваши игры заметили. Хочу у вас игру: {genre}, сеттинг «{setting}», к следующему кварталу. Аванс дам сейчас, долю возьму с продаж. Ну или не дам, и делайте дальше что хотите."
line_warm = "Снова я, и снова с деньгами. Хочу {genre}, сеттинг «{setting}». Аванс щедрый, доля с продаж как обычно, мы же друзья."
line_cold = "Прошлый раз вы отказали, но я не гордый. {genre}, сеттинг «{setting}». Аванс, доля с продаж. Второй раз спрашивать не буду."
lines_alt = PackedStringArray("Есть заказ: {genre}, сеттинг «{setting}». Аванс сегодня, моя доля с продаж потом. Берёте?", "У меня на полке не хватает одной игры: {genre}, сеттинг «{setting}». Аванс плачу сразу, с продаж беру долю. По рукам?")
lines_warm_alt = PackedStringArray("С вами приятно работать, поэтому я снова здесь. {genre}, сеттинг «{setting}», аванс больше прежнего, доля с продаж та же.", "Прошлая наша игра окупилась, давайте повторим! {genre}, сеттинг «{setting}». Аванс на столе.")
lines_cold_alt = PackedStringArray("Знаю, что вы скажете. И всё же: {genre}, сеттинг «{setting}», аванс и доля с продаж. Подумайте хотя бы минуту.", "Мы не сошлись в прошлый раз, бывает. Предложение новое: {genre}, сеттинг «{setting}». Аванс, доля с продаж.")
choices = Array[ExtResource("3_choice")]([SubResource("Res_5"), SubResource("Res_9"), SubResource("Res_10")])
cooldown = 4
once = false
priority = 0
