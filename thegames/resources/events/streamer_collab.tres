character = ExtResource("4_char")
condition = &"viral_game"
line = "Ваша вирусная штука у меня в чате до сих пор. Давайте следующую игру я покажу первым. Эфир стоит денег, но мои зрители того стоят."
line_warm = "После прошлого эфира чат требует ещё. Давайте снова: следующую игру первым у меня, цена прежняя."
line_cold = "Прошлый раз вы мне отказали, но я не злопамятный. Эфир со следующей игрой?"
choices = Array[ExtResource("3_choice")]([SubResource("Res_3"), SubResource("Res_4")])
cooldown = 4
once = false
priority = 0
