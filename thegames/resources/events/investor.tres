[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://scripts/events/event_def.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/events/effect_def.gd" id="2_eff"]
[ext_resource type="Script" path="res://scripts/events/choice_def.gd" id="3_choice"]
[ext_resource type="Resource" path="res://resources/characters/investor.tres" id="4_char"]

[sub_resource type="Resource" id="Res_1"]
script = ExtResource("2_eff")
kind = 0
amount = 15000

[sub_resource type="Resource" id="Res_2"]
script = ExtResource("2_eff")
kind = 4
value = -1

[sub_resource type="Resource" id="Res_3"]
script = ExtResource("3_choice")
text = "Деньги сейчас, технология ваша"
effects = Array[ExtResource("2_eff")]([SubResource("Res_1"), SubResource("Res_2")])

[sub_resource type="Resource" id="Res_4"]
script = ExtResource("2_eff")
kind = 0
amount = 8000

[sub_resource type="Resource" id="Res_5"]
script = ExtResource("2_eff")
kind = 6
share = 0.2
games = 2

[sub_resource type="Resource" id="Res_6"]
script = ExtResource("3_choice")
text = "Поменьше и без условий"
effects = Array[ExtResource("2_eff")]([SubResource("Res_4"), SubResource("Res_5")])

[sub_resource type="Resource" id="Res_7"]
script = ExtResource("3_choice")
text = "Справимся сами"

[resource]
script = ExtResource("1_event")
id = &"investor"
title = "Инвестор"
kind = 0
character = ExtResource("4_char")
condition = &"investor_low_cash"
line = "Вижу, с деньгами у вас туго. Вложусь, но технологию следующей игры выберу сама: {tech}. Или дам меньше, но заберу долю с двух следующих игр."
line_warm = ""
line_cold = ""
choices = Array[ExtResource("3_choice")]([SubResource("Res_3"), SubResource("Res_6"), SubResource("Res_7")])
