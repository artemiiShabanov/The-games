# --- event card, pills ---
msgid "Вставка"
msgstr "Event"

msgid "«%s»"
msgstr "“%s”"

msgid "↑ ↓ выбрать"
msgstr "↑ ↓ choose"

msgid "решить"
msgstr "decide"

msgid "в хорошем настроении"
msgstr "in a good mood"

msgid "помнит прошлый отказ"
msgstr "remembers your last no"

msgid "или"
msgstr "or"

msgid "монетка"
msgstr "coin flip"

msgid "%s обидится"
msgstr "%s takes offense"

msgid "%s запомнит"
msgstr "%s will remember"

msgid "репутация %s"
msgstr "reputation %s"

msgid "сиквел"
msgstr "sequel"

msgid "−%d %% с продаж%s"
msgstr "−%d%% of sales%s"

msgid "критики"
msgstr "critics"

msgid "стримеры"
msgstr "streamers"

msgid "продажи"
